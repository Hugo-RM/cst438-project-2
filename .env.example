# Copy to .env (gitignored) only if you want to use the shared Neon database instead of the local one.
# Leave unset to use the local Postgres from docker-compose.yml.
DATABASE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
DATABASE_USERNAME=<neon-user>
DATABASE_PASSWORD=<neon-password>

# OAuth client ID that issued the Android app's Google tokens; JWTs with any other audience are rejected.
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Required: signs the API's own login tokens. Generate with: openssl rand -base64 32
APP_TOKEN_SECRET=<base64-32-bytes>
